# Leave empty when using Docker Compose (Vite proxies /api to localhost:3000).
VITE_API_BASE_URL=http://localhost:8080

# Optional: change the Vite dev proxy target (default: http://localhost:3000).
# VITE_DEV_API_PROXY=http://localhost:3000

# When running the Go backend locally on port 8080 (without Docker), use:
# VITE_API_BASE_URL=http://localhost:8080
