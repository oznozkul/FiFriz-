APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8080
APP_READ_TIMEOUT=30s
APP_WRITE_TIMEOUT=5m
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s

# Set to false when running cmd/worker as a separate process (Docker compose).
RUN_IN_PROCESS_WORKER=true

# Option A: full DSN (takes priority when set)
# DATABASE_DSN=host=localhost user=postgres password=postgres dbname=fifriz port=5432 sslmode=disable TimeZone=UTC

# Option B: individual fields (used when DATABASE_DSN is empty)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=fifriz
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=UTC
DATABASE_MAX_IDLE_CONNS=10
DATABASE_MAX_OPEN_CONNS=50
DATABASE_CONN_MAX_LIFETIME=1h

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_KEY=fifriz:jobs

DOCUMENT_STORAGE_DIR=storage/documents
LOCAL_STORAGE_PATH=storage/documents
STORAGE_PROVIDER=local
STORAGE_PROCESSING_DIR=tmp/processing

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fifiz-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

JWT_SECRET=change-me-in-production
JWT_ISSUER=fifriz
JWT_DURATION=24h

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

AI_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_CHAT_TIMEOUT=5m

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Belge dogrulama ve depolama indirme dayanikliligi
DOCUMENT_MAX_FILE_SIZE_BYTES=104857600
DOCUMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,image/webp,text/plain,text/csv,application/json,application/xml,text/html,message/rfc822,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
STORAGE_DOWNLOAD_RETRIES=3
STORAGE_DOWNLOAD_TIMEOUT=30s

PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8080

APP_FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/v1/integrations/gmail/callback
GOOGLE_GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.readonly

GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URL=http://localhost:3000/api/v1/integrations/google-drive/callback
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.readonly

MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URL=http://localhost:8080/api/v1/integrations/outlook/callback
MICROSOFT_SCOPES=offline_access User.Read Mail.Read

MICROSOFT_ONEDRIVE_CLIENT_ID=
MICROSOFT_ONEDRIVE_CLIENT_SECRET=
MICROSOFT_ONEDRIVE_TENANT=common
MICROSOFT_ONEDRIVE_REDIRECT_URL=http://localhost:3000/api/v1/integrations/onedrive/callback
MICROSOFT_ONEDRIVE_SCOPES=offline_access User.Read Files.Read.All

# Mail entegrasyonlari otomatik senkronizasyon araligi (0 = kapali)
INTEGRATION_SYNC_INTERVAL=15m
