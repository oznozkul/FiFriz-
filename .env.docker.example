APP_ENV=docker
APP_HOST=0.0.0.0
APP_PORT=3000

# Vectopos Postgres (docker: vectopos-db → host:5432)
# Uygulama DATABASE_NAME yoksa otomatik CREATE DATABASE yapar.
DATABASE_HOST=host.docker.internal
DATABASE_PORT=5432
DATABASE_USER=ordermanagement
DATABASE_PASSWORD=CHANGE_ME
DATABASE_NAME=FiFrizDb
DATABASE_SSLMODE=disable
DATABASE_TIMEZONE=UTC

REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_KEY=fifriz:jobs

STORAGE_PROVIDER=minio
STORAGE_PROCESSING_DIR=tmp/processing

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=fifiz-documents
MINIO_USE_SSL=false
MINIO_REGION=us-east-1

APP_FRONTEND_URL=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:13000

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

JWT_SECRET=dev-secret-change-me
JWT_ISSUER=fifriz
JWT_DURATION=24h

RUN_IN_PROCESS_WORKER=false

EMBEDDING_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_EMBEDDING_MODEL=bge-m3

AI_PROVIDER=ollama
OLLAMA_CHAT_MODEL=llama3.1:8b
OLLAMA_CHAT_TIMEOUT=5m

APP_READ_TIMEOUT=30s
APP_WRITE_TIMEOUT=5m

INTEGRATION_SYNC_INTERVAL=15m
